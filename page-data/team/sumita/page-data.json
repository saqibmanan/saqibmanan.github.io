{"componentChunkName":"component---src-templates-member-js","path":"/team/sumita/","result":{"data":{"markdownRemark":{"id":"4d0847a5-30d9-5454-9629-b4757d24a3fe","html":"<p>Sumita Gupta is an Accounts and Operations professional with over 18 years of experience in Accounts, Finance, and Operations. She focuses on strengthening accounting processes, ensuring accuracy, and supporting efficient organisational operations. She believes in bringing efficiency, and attention to detail to her work.</p>\n<p>She holds a Master's in Business Administration (Finance) from Sikkim Manipal University. She has hands-on experience in accounting and statutory compliance, supporting auditing processes. She has worked extensively in the development and social impact sectors, including CBGA and PHRS. </p>\n<p>Beyond work, she enjoys travelling and watching Pakistani dramas.</p>","frontmatter":{"name":"Sumita Gupta","role":"Finance & Operations-Consultant","description":null,"quote":"","image":{"childImageSharp":{"fluid":{"base64":"data:image/jpeg;base64,","aspectRatio":0.7490636704119851,"src":"/static/046f1278d78d58c9fd95ddc37fa656cb/2f1b1/sumita.jpg","srcSet":"/static/046f1278d78d58c9fd95ddc37fa656cb/fd013/sumita.jpg 200w,\n/static/046f1278d78d58c9fd95ddc37fa656cb/25252/sumita.jpg 400w,\n/static/046f1278d78d58c9fd95ddc37fa656cb/2f1b1/sumita.jpg 800w,\n/static/046f1278d78d58c9fd95ddc37fa656cb/0ff54/sumita.jpg 1200w","sizes":"(max-width: 800px) 100vw, 800px"}}},"medium":null,"github":null,"linkedin":"https://www.linkedin.com/in/sumita-gupta-825441360/","twitter":null,"behance":null,"accentcolor":null,"text":null}}},"pageContext":{"id":"4d0847a5-30d9-5454-9629-b4757d24a3fe"}},"staticQueryHashes":["203280391","2269431855","2668793990"]}