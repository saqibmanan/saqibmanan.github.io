/a906f/studionilima.com.jpg 1x,\n/static/b9aa96189b8db348ec80b88263d578bb/fbe0e/studionilima.com.jpg 1.5x,\n/static/b9aa96189b8db348ec80b88263d578bb/474e4/studionilima.com.jpg 2x"}}},{"id":"c843b91a-8ca2-5a30-9c1d-b106417db943","name":"vidhilegalpolicy.in","childImageSharp":{"fixed":{"width":160,"height":20,"src":"/static/8234b86c1f4ce3d6a177756c15897314/a40ad/vidhilegalpolicy.in.png","srcSet":"/static/8234b86c1f4ce3d6a177756c15897314/a40ad/vidhilegalpolicy.in.png 1x,\n/static/8234b86c1f4ce3d6a177756c15897314/67196/vidhilegalpolicy.in.png 1.5x"}}}]},"allMarkdownRemark":{"nodes":[{"fields":{"slug":"/work/climateaction/"},"frontmatter":{"name":"Climate Action","description":"We co-create data collaboratives and tools for effective, data-driven decision making to address climate change. We work closely with multiple stakeholders to institutionalise data and AI capacities, accessibility and usability for public reforms and citizen engagement.","image":{"childImageSharp":{"fluid":{"base64":"data:image/png;base64,","aspectRatio":1.1450381679389312,"src":"/static/31cf2417dc89ce57999c7ea4cc213be3/8c332/climateAction.png","srcSet":"/static/31cf2417dc89ce57999c7ea4cc213be3/95f17/climateAction.png 150w,\n/static/31cf2417dc89ce57999c7ea4cc213be3/37d5a/climateAction.png 300w,\n/static/31cf2417dc89ce57999c7ea4cc213be3/8c332/climateAction.png 600w,\n/static/31cf2417dc89ce57999c7ea4cc213be3/03620/climateAction.png 900w,\n/static/31cf2417dc89ce57999c7ea4cc213be3/6050d/climateAction.png 1200w,\n/static/31cf2417dc89ce57999c7ea4cc213be3/1e6f7/climateAction.png 5492w","sizes":"(max-width: 600px) 100vw, 600px"}}},"color":"#7ac9c3ff"}},{"fields":{"slug":"/work/dpg/"},"frontmatter":{"name":"DPG&I and Responsible AI","description":"We are co-creating people-centric Digital Public Goods (DPGs) and strengthening Digital Infrastructure (DPI) via our Open Data platforms, Data Exchange platform, Intelligent Data Science models, Al-enabled Chatbots and Citizen-led Apps for improving participatory data-driven governance. Our solutions are focused on making data accessible and usable as well as improving data-tech capacities. They are built on principles of privacy by design and adhere to the national and international applicable laws.","image":{"childImageSharp":{"fluid":{"base64":"data:image/png;base64,","aspectRatio":1.1627906976744187,"src":"/static/fe4f3f5b0470ca85b78f814e4cc43a43/f9828/dpg.png","srcSet":"/static/fe4f3f5b0470ca85b78f814e4cc43a43/95f17/dpg.png 150w,\n/static/fe4f3f5b0470ca85b78f814e4cc43a43/f9828/dpg.png 278w","sizes":"(max-width: 278px) 100vw, 278px"}}},"color":"#74719e"}},{"fields":{"slug":"/work/genderinclusion/"},"frontmatter":{"name":"Gender & Inclusion","description":"We work to bring a gender and inclusion lens to data, technology and public systems, building a more holistic understanding of the diverse needs and experiences of women, girls, persons with disabilities (PwDs), and other marginalised communities. We co-create data-driven tools and approaches with governments and ecosystem partners, while building capacities to integrate gender and inclusion into public planning, finance, and decision-making.","image":{"childImageSharp":{"fluid":{"base64":"data:image/png;base64,","aspectRatio":0.7978723404255319,"src":"/static/c4c4bcb5e0d4121052840f5d92a761f1/8c332/gender.png","srcSet":"/static/c4c4bcb5e0d4121052840f5d92a761f1/95f17/gender.png 150w,\n/static/c4c4bcb5e0d4121052840f5d92a761f1/37d5a/gender.png 300w,\n/static/c4c4bcb5e0d4121052840f5d92a761f1/8c332/gender.png 600w,\n/static/c4c4bcb5e0d4121052840f5d92a761f1/03620/gender.png 900w,\n/static/c4c4bcb5e0d4121052840f5d92a761f1/a45dc/gender.png 1080w","sizes":"(max-width: 600px) 100vw, 600px"}}},"color":"#8a5a7d"}},{"fields":{"slug":"/work/lawandjustice/"},"frontmatter":{"name":"Law & Justice","description":"We create and curate high quality public datasets in the areas of law and justice. We build open data portals to increase information accessibility and conduct trainings and workshops for our partners to enhance their data and tech capacity.","image":{"childImageSharp":{"fluid":{"base64":"data:image/png;base64,","aspectRatio":1.094890510948905,"src":"/static/9e8ecf1ee47a9a3e95bc8d8e0eba9d05/24d52/lnj.png","srcSet":"/static/9e8ecf1ee47a9a3e95bc8d8e0eba9d05/95f17/lnj.png 150w,\n/static/9e8ecf1ee47a9a3e95bc8d8e0eba9d05/24d52/lnj.png 262w","sizes":"(max-width: 262px) 100vw, 262px"}}},"color":"#4b4140"}},{"fields":{"slug":"/work/opencontracting/"},"frontmatter":{"name":"Open Contracting","description":"We curate Public Finance data by following the flow of funds through budgets all the way through to public procurements. We are working on building open source tools to track, visualize, and analyze this information.","image":{"childImageSharp":{"fluid":{"base64":"data:image/png;base64,","aspectRatio":1.0067114093959733,"src":"/static/ca15f6edbb87454cea54f47a3b492dc4/9c5b9/oci.png","srcSet":"/static/ca15f6edbb87454cea54f47a3b492dc4/95f17/oci.png 150w,\n/static/ca15f6edbb87454cea54f47a3b492dc4/9c5b9/oci.png 241w","sizes":"(max-width: 241px) 100vw, 241px"}}},"color":"#076775"}},{"fields":{"slug":"/work/publicfinance/"},"frontmatter":{"name":"Public Finance","description":"We curate Public Finance data by following the flow of funds through budgets all the way through to public procurements. We are working on building open source tools to track, visualize, and analyze this information.","image":{"childImageSharp":{"fluid":{"base64":"data:image/png;base64,","aspectRatio":0.967741935483871,"src":"/static/fa65d7def51a64a5b401a3a7d6ce52c3/0edb3/pf.png","srcSet":"/static/fa65d7def51a64a5b401a3a7d6ce52c3/95f17/pf.png 150w,\n/static/fa65d7def51a64a5b401a3a7d6ce52c3/0edb3/pf.png 232w","sizes":"(max-width: 232px) 100vw, 232px"}}},"color":"#525568"}},{"fields":{"slug":"/work/urbandevelopment/"},"frontmatter":{"name":"Urban Development","description":"We are delving into the space of urban governance, where we work towards facilitating citizen engagement through making public information accessible on open data platforms. We also work towards involving the citizens in generating information relevant to their well-being, especially during the time of disasters.","image":{"childImageSharp":{"fluid":{"base64":"data:image/png;base64,","aspectRatio":1.2,"src":"/static/1d6d6de6bd62467be8a613d68bc0166e/4109c/ud.png","srcSet":"/static/1d6d6de6bd62467be8a613d68bc0166e/95f17/ud.png 150w,\n/static/1d6d6de6bd62467be8a613d68bc0166e/4109c/ud.png 287w","sizes":"(max-width: 287px) 100vw, 287px"}}},"color":"#4b4140"}}]}},"pageContext":{}},"staticQueryHashes":["1001143701","1335860","203280391","2269431855","2668793990","3132855039"]}